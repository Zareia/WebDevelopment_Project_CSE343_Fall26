{
  "name": "event-ticketing",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n server,attendee,organizer -c blue,green,magenta \"npm:dev:server\" \"npm:dev:attendee\" \"npm:dev:organizer\"",
    "dev:server": "npm run dev -w server",
    "dev:attendee": "npm run dev -w attendee",
    "dev:organizer": "npm run dev -w organizer",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
