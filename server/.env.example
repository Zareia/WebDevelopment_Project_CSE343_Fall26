# Copy this file to .env (in this server/ folder) and fill in real values. Never commit .env.

# API
PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/event-ticketing

# Secret used to sign auth tokens (use a long random string)
JWT_SECRET=change-me

# Comma-separated origins allowed by CORS in development
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174
